generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  avatarUrl        String?
  role             String    @default("user")
  xp               Int       @default(0)
  level            Int       @default(1)
  coins            Int       @default(0)
  streak           Int       @default(0)
  lastPracticeDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile          Profile?
  practiceSessions PracticeSession[]
  drawings         DrawingSubmission[]
  achievements     UserAchievement[]
  challengeEntries ChallengeParticipant[]
  communityPosts   CommunityPost[]
  comments         Comment[]
  likes            Like[]
  followers        Follow[]           @relation("following")
  following        Follow[]           @relation("follower")
  collections      Collection[]
  bookmarks        Bookmark[]
  articles         Article[]
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  bio                 String?
  phone               String?
  age                 Int?
  exam                String?
  studyMode           String?
  institution         String?
  educationLevel      String?
  goals               String?
  interests           String?
  city                String?
  country             String?
  favoriteCategories  String   @default("[]")
  avatarCustomization String?
  theme               String   @default("system")
  reducedMotion       Boolean  @default(false)
  highContrast        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?
  imageCount  Int    @default(0)
  sortOrder   Int    @default(0)

  images ReferenceImage[]
}

model ReferenceImage {
  id             String   @id @default(cuid())
  url            String
  thumbnailUrl   String?
  categoryId     String
  gender         String?
  ageGroup       String?
  bodyType       String?
  clothing       String?
  difficulty     String?
  cameraAngle    String?
  lighting       String?
  colorMode      String?
  orientation    String?
  learningStages String?
  width          Int?
  height         Int?
  duration       Int?
  isPublished    Boolean  @default(false)
  uploadedAt     DateTime @default(now())

  category       Category           @relation(fields: [categoryId], references: [id])
  practiceSessions PracticeSession[]
  drawings       DrawingSubmission[]
  challenges     Challenge[]
  bookmarks      Bookmark[]
  collectionItems CollectionItem[]

  @@index([categoryId])
}

model PracticeSession {
  id          String   @id @default(cuid())
  userId      String
  referenceId String
  duration    Int
  isSkipped   Boolean  @default(false)
  rating      Int?
  notes       String?
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference ReferenceImage @relation(fields: [referenceId], references: [id])

  @@index([userId])
}

model DrawingSubmission {
  id          String   @id @default(cuid())
  userId      String
  referenceId String
  imageUrl    String
  rating      Int?
  feedback    String?
  createdAt   DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference ReferenceImage @relation(fields: [referenceId], references: [id])

  @@index([userId])
}

model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  xpReward    Int      @default(0)
  condition   String
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model Challenge {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  imageUrl    String?
  referenceId String?
  difficulty  String?
  duration    Int?
  rewardTitle String?
  rewardXP    Int      @default(50)
  rewardCoins Int      @default(10)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  reference    ReferenceImage?        @relation(fields: [referenceId], references: [id])
  participants ChallengeParticipant[]

  @@index([startDate, endDate])
  @@index([isActive])
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  score       Int?
  completedAt DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model CommunityPost {
  id            String   @id @default(cuid())
  userId        String
  drawingId     String?  @unique
  caption       String?
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  referenceId  String
  addedAt      DateTime @default(now())

  collection Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reference  ReferenceImage @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([collectionId, referenceId])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  imageUrl    String?
  authorId    String
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([isPublished, sortOrder])
  @@index([slug])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  referenceId String
  createdAt   DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference ReferenceImage @relation(fields: [referenceId], references: [id])

  @@unique([userId, referenceId])
}
